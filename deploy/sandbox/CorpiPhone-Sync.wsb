<!--
  Windows Sandbox configuration for the CorpiPhone directory sync admin workstation.

  1. On the host, create a folder (for example C:\CorpiPhone-Sandbox) and copy Initialize-SandboxEnvironment.ps1 into it.
  2. Edit HostFolder below to that path.
  3. Double-click this .wsb file. The Sandbox opens and, after the desktop appears, a visible "CorpiPhone setup" window
     runs the setup script in Windows PowerShell 5.1 (LogonCommand itself runs hidden, so it starts that window);
     it installs PowerShell 7.6, Git, the modules, clones the repo and runs the tests, then opens a PowerShell 7 window.

  The mapped folder is read-only inside the Sandbox, so nothing you do there can touch the host.
  Everything inside the Sandbox is discarded when you close it.
-->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\CorpiPhone-Sandbox</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\Setup</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "CorpiPhone setup" powershell.exe -ExecutionPolicy Bypass -NoExit -File C:\Users\WDAGUtilityAccount\Desktop\Setup\Initialize-SandboxEnvironment.ps1</Command>
  </LogonCommand>
  <Networking>Default</Networking>
  <MemoryInMB>8192</MemoryInMB>
  <ClipboardRedirection>Enable</ClipboardRedirection>
</Configuration>
